{
  "name": "Call",
  "type": "object",
  "properties": {
    "competitionId": {
      "type": "string"
    },
    "raceId": {
      "type": "string"
    },
    "roundId": {
      "type": "string"
    },
    "genderGroup": {
      "type": "string",
      "enum": [
        "MEN",
        "WOMEN",
        "MIXED",
        "MEN Relay (5000m)",
        "WOMEN Relay (3000m)"
      ]
    },
    "refereeId": {
      "type": "string"
    },
    "refereeName": {
      "type": "string"
    },
    "refereeFunction": {
      "type": "string"
    },
    "callCode": {
      "type": "string"
    },
    "mark": {
      "type": "string"
    },
    "athleteId": {
      "type": "string"
    },
    "helmetNumber": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "raceId",
    "refereeId",
    "callCode"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}