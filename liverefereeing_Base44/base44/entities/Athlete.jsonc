{
  "name": "Athlete",
  "type": "object",
  "properties": {
    "competitionId": {
      "type": "string"
    },
    "genderGroup": {
      "type": "string",
      "enum": [
        "MEN",
        "WOMEN",
        "MIXED",
        "MEN Relay (5000m)",
        "WOMEN Relay (3000m)"
      ]
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "helmetNumber": {
      "type": "string"
    }
  },
  "required": [
    "competitionId",
    "genderGroup",
    "firstName",
    "lastName",
    "country"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}