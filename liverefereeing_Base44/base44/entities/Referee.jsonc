{
  "name": "Referee",
  "type": "object",
  "properties": {
    "displayName": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "passwordHash": {
      "type": "string"
    },
    "salt": {
      "type": "string"
    },
    "passwordPlain": {
      "type": "string"
    },
    "assignedCompetitionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assignedGenderGroups": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "MEN",
          "WOMEN",
          "MIXED",
          "MEN Relay (5000m)",
          "WOMEN Relay (3000m)"
        ]
      }
    },
    "function": {
      "type": "string",
      "enum": [
        "NONE",
        "TC",
        "APPR"
      ],
      "default": "NONE"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "loginConfirmed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "displayName",
    "username"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}